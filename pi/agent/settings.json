{
  "lastChangelogVersion": "1.4.0",
  "theme": "kosmos",
  "defaultProvider": "minimax",
  "defaultModel": "MiniMax-M3.1-Flash",
  "defaultThinkingLevel": "medium",
  "hideThinkingBlock": true,
  "packages": [
    "npm:pi-mcp-adapter",
    "npm:pi-web-access",
    "npm:pi-subagents@0.89.1",
    "npm:@juicesharp/rpiv-todo",
    "npm:pi-ask-user"
  ],
  "extensions": [
    "-builtin:mcp"
  ],
  "subagents": {
    "defaultThinking": "medium",
    "maxThinking": "high",
    "defaultExtensions": [],
    "agentOverrides": {
      "researcher": {
        "extensions": ["~/.pi/agent/npm/node_modules/pi-web-access"]
      },
      "evidence-auditor": {
        "extensions": ["~/.pi/agent/npm/node_modules/pi-web-access"]
      }
    }
  }
}
